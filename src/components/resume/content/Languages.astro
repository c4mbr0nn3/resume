---
import Title from './Title.astro'

const { languages, t } = Astro.props
---

<section data-reveal-group>
  <Title title={t.languages} />
  <dl data-reveal-list class="flex flex-col gap-2">
    {languages.map((item: any) => (
      <div class="entry flex flex-wrap items-baseline gap-2">
        <dt class="text-lg font-medium text-stone-900 dark:text-stone-100">{item.language}</dt>
        <dd class="text-stone-600 dark:text-stone-400 font-light">— {item.fluency}</dd>
      </div>
    ))}
  </dl>
</section>
