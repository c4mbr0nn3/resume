---
import Title from './Title.astro'

const { skills, t } = Astro.props
---

<section data-reveal-group>
  <Title title={t.skills} />
  <div data-reveal-list class="flex flex-col gap-4 lg:gap-[18px]">
    {skills.map((item: any) => (
      <div class="skill-row entry grid break-inside-avoid gap-0.5 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-x-10">
        <h3 class="text-base font-semibold text-stone-900 dark:text-stone-100">{item.name}</h3>
        <p class="skill-kw max-w-[65ch] font-light text-stone-600 dark:text-stone-300">{item.keywords.join(' · ')}</p>
      </div>
    ))}
  </div>
</section>
