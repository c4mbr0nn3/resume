---
import { Icon } from 'astro-icon/components'
import Markdown from '../../Markdown.astro'

const { content } = Astro.props
---

<li class="entry flex gap-2">
  <span class="mb-auto">
    <Icon name="carbon:chevron-right" class="mt-1 text-orange-700 dark:text-orange-400" aria-hidden="true" />
  </span>
  <Markdown content={content} />
</li>
