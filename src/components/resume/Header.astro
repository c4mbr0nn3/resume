---
import Contacts from './Contacts.astro'

const { basics } = Astro.props
const name = basics.name
const labelParts = basics.label.split('|').map((s: string) => s.trim())
const location = `${basics.location.city}, ${basics.location.region}`
---

<header>
  <h1 class="font-serif text-[clamp(2.75rem,8vw,6.75rem)] font-bold leading-[1.02] tracking-[-0.03em] text-stone-900 dark:text-stone-50">
    <span class="line-mask -mb-[0.09em] block overflow-hidden pb-[0.09em]">
      <span class="block">{name}</span>
    </span>
  </h1>
  <p data-rise style="--i:1" class="pb-4 font-serif text-base text-stone-600 dark:text-stone-300 sm:text-lg lg:text-2xl">
    <span class="block sm:inline">{labelParts[0]} · {labelParts[1]}</span>
    <span class="hidden sm:inline" aria-hidden="true"> · </span>
    <span class="block sm:inline">{location}</span>
  </p>
  <div data-rise style="--i:3">
    <Contacts basics={basics} />
  </div>
</header>
