---
import { Icon } from 'astro-icon/components'

const { currentLocale, t } = Astro.props
---

<nav
  aria-label={t['nav.languageAndTheme']}
  class="absolute right-4 top-4 flex items-center gap-1 text-xs text-stone-600 print:hidden dark:text-stone-400"
>
  <button
    id="theme-toggle"
    data-state="light"
    aria-label={t['theme.toggle']}
    aria-pressed="false"
    class="h-6 w-6 cursor-pointer p-1 transition-colors hover:text-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 dark:hover:text-stone-200 dark:focus-visible:outline-orange-400"
  >
    <span data-for="light"><Icon name="carbon:sun" /></span>
    <span data-for="dark"><Icon name="carbon:moon" /></span>
  </button>
  <span class="select-none text-stone-400 dark:text-stone-600" aria-hidden="true">|</span>
  <Icon name="carbon:translate" class="h-4 w-4" aria-hidden="true" />
  <a
    href="/"
    data-locale="en"
    class={`inline-flex min-h-6 min-w-6 items-center justify-center px-1 ${currentLocale === 'en' ? 'font-medium text-orange-700 dark:text-orange-400' : 'transition-colors hover:text-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 dark:hover:text-stone-200 dark:focus-visible:outline-orange-400'}`}
    aria-current={currentLocale === 'en' ? 'page' : undefined}
  >EN</a>
  <span aria-hidden="true">/</span>
  <a
    href="/it/"
    data-locale="it"
    class={`inline-flex min-h-6 min-w-6 items-center justify-center px-1 ${currentLocale === 'it' ? 'font-medium text-orange-700 dark:text-orange-400' : 'transition-colors hover:text-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 dark:hover:text-stone-200 dark:focus-visible:outline-orange-400'}`}
    aria-current={currentLocale === 'it' ? 'page' : undefined}
  >IT</a>
</nav>

<script>
  const btn = document.getElementById('theme-toggle') as HTMLButtonElement
  const STATES = ['light', 'dark'] as const
  type ThemeState = typeof STATES[number]

  function getCookie(name: string): string | null {
    const m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'))
    return m ? decodeURIComponent(m[1]) : null
  }

  function setTheme(state: ThemeState) {
    btn.dataset.state = state
    btn.setAttribute('aria-pressed', String(state === 'dark'))
    document.cookie = `theme=${state}; max-age=31536000; path=/; SameSite=Lax; Secure`
    document.documentElement.classList.toggle('dark', state === 'dark')
  }

  const saved = getCookie('theme') as ThemeState | null
  const initial: ThemeState = saved === 'dark' ? 'dark' : 'light'
  btn.dataset.state = initial
  btn.setAttribute('aria-pressed', String(initial === 'dark'))

  btn.addEventListener('click', () => {
    const current = btn.dataset.state as ThemeState
    const next = STATES[(STATES.indexOf(current) + 1) % STATES.length]
    setTheme(next)
  })

  document.querySelectorAll<HTMLAnchorElement>('a[data-locale]').forEach((link) => {
    link.addEventListener('click', () => {
      document.cookie = `locale=${link.dataset.locale}; max-age=31536000; path=/; SameSite=Lax; Secure`
    })
  })
</script>
