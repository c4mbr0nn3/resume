---
import { useTranslations } from '../i18n/utils'
import BaseLayout from '../layouts/BaseLayout.astro'

const t = useTranslations('en')
const title = 'Page not found | Francesco Zorzi'
const description = 'The page you are looking for does not exist.'
---

<BaseLayout title={title} description={description} lang="en" noindex={true} t={t}>
  <main id="main" class="flex min-h-[60vh] flex-col items-start justify-center gap-4 bg-white p-5 sm:rounded-xl sm:p-10 sm:shadow-xl dark:bg-stone-900 dark:shadow-none dark:ring-1 dark:ring-stone-700/50">
    <p class="font-mono text-sm text-stone-500 dark:text-stone-400">404</p>
    <h1 class="font-serif text-4xl font-bold tracking-tight text-orange-700 dark:text-orange-400">Page not found</h1>
    <p class="max-w-[65ch] text-stone-600 dark:text-stone-400">
      The page you are looking for does not exist or has been moved.
    </p>
    <nav class="flex items-center gap-4">
      <a href="/" class="text-orange-700 underline hover:text-orange-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 dark:text-orange-400 dark:hover:text-orange-300 dark:focus-visible:outline-orange-400">Resume (EN)</a>
      <a href="/it/" class="text-orange-700 underline hover:text-orange-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 dark:text-orange-400 dark:hover:text-orange-300 dark:focus-visible:outline-orange-400">Curriculum (IT)</a>
    </nav>
  </main>
</BaseLayout>
