---
import resumeData from '../assets/resume.en.json'
import TheFooter from '../components/TheFooter.astro'
import TheResume from '../components/TheResume.astro'
import { useTranslations } from '../i18n/utils'
import BaseLayout from '../layouts/BaseLayout.astro'
import { buildPersonSchema } from '../lib/seo'

const t = useTranslations('en')
const { basics, work, education, skills, projects, languages } = resumeData

const title = 'Francesco Zorzi | Software Engineer | Resume'
const description = 'Senior Software Engineer specializing in .NET backend development and SaaS e-invoicing. Expertise in C#, EF Core, Vue.js, and full-stack development.'
const jsonLd = buildPersonSchema(resumeData, 'en')
---

<BaseLayout title={title} description={description} lang="en" jsonLd={jsonLd} t={t}>
  <TheResume basics={basics} work={work} education={education} skills={skills} projects={projects} languages={languages} t={t} currentLocale="en" />
  <TheFooter t={t} currentLocale="en" />
</BaseLayout>
